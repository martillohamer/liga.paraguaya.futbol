# Copia este archivo como .env y llena los valores
# cp .env.example .env

# Neon PostgreSQL (produccion) — la URL debe incluir ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# PostgreSQL local (Docker) — alternativa para desarrollo sin internet
# DATABASE_URL=postgresql://liga:liga_password@localhost:5432/liga
